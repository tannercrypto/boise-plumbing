# ─────────────────────────────────────────────────────────────────────────────
# .env.example — copy to .env.local and fill in every value
# NEVER commit .env.local to version control
# Generate random secrets with: openssl rand -hex 32
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
# Supabase: Project → Settings → Database → Connection String → Transaction Pooler
# Local:    postgresql://postgres:password@localhost:5432/boise_plumbing
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?schema=public&pgbouncer=true"

# ── Admin Auth ────────────────────────────────────────────────────────────────
# This is BOTH the admin login password and the HMAC session signing secret.
# Min 16 characters. Production: openssl rand -hex 32 (64-char output)
# Changing this invalidates all active sessions immediately.
ADMIN_SECRET_KEY="generate_with_openssl_rand_hex_32"

# ── Optional: separate report token secret ────────────────────────────────────
# If not set, falls back to ADMIN_SECRET_KEY (namespaced internally)
# REPORT_TOKEN_SECRET="generate_with_openssl_rand_hex_32"

# ── Jobber OAuth ──────────────────────────────────────────────────────────────
# Create app at: https://developer.getjobber.com/ → My Apps
# Redirect URI must exactly match the Jobber Developer Portal registration
JOBBER_CLIENT_ID="your_jobber_client_id"
JOBBER_CLIENT_SECRET="your_jobber_client_secret"
JOBBER_REDIRECT_URI="https://yourdomain.com/api/jobber/callback"
JOBBER_API_VERSION="2024-11-15"

# ── Site ──────────────────────────────────────────────────────────────────────
# Used in sitemap.xml, JSON-LD, and canonical URLs — must be the live domain
NEXT_PUBLIC_SITE_URL="https://boiseplumbing.com"

# ❗ Client must provide these — phone number displayed on the website
# NEXT_PUBLIC_PHONE format:       "(208) 555-1234"   — displayed to users
# NEXT_PUBLIC_PHONE_E164 format:  "tel:+12085551234" — used in href links
NEXT_PUBLIC_PHONE="(208) 555-XXXX"
NEXT_PUBLIC_PHONE_E164="tel:+1208555XXXX"

# ── Google Analytics / Search Console ────────────────────────────────────────
# Create OAuth credentials at: https://console.cloud.google.com/
# Enable: Google Search Console API + Google Analytics Data API
# Add authorized redirect URIs in Google Cloud Console
GOOGLE_CLIENT_ID="your_google_client_id"
GOOGLE_CLIENT_SECRET="your_google_client_secret"
GOOGLE_REDIRECT_URI_GSC="https://yourdomain.com/api/admin/analytics/gsc/callback"
GOOGLE_REDIRECT_URI_GA4="https://yourdomain.com/api/admin/analytics/ga4/callback"

# ── Cron jobs ─────────────────────────────────────────────────────────────────
# Passed as x-cron-secret header to /api/cron/* endpoints
# Vercel cron.json triggers these automatically — also used for manual runs
CRON_SECRET="generate_with_openssl_rand_hex_32"

# ── Mac message bridge ────────────────────────────────────────────────────────
# Used by mac-message-bridge script AND /api/messages/* AND /api/calls/inbound
# NEVER expose to browser or any client-rendered page
LOCAL_BRIDGE_API_KEY="generate_with_openssl_rand_hex_32"

# ─────────────────────────────────────────────────────────────────────────────
# NOTE: SESSION_SECRET, ENCRYPTION_KEY, and NEXT_PUBLIC_TRACKING_PHONE
# are NOT used by this codebase. Do not add them — they have no effect.
# Session signing uses ADMIN_SECRET_KEY. No encryption layer exists.
# The tracking phone is stored in the Site database record, not env vars.
# ─────────────────────────────────────────────────────────────────────────────
